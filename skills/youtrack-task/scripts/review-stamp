#!/usr/bin/env bash
# review-stamp — record and check "reviewed: PASS on this exact commit".
# Local workflow guard, not a security boundary: the stamp lives in the git
# directory (shared by all worktrees, never pushed, not in the working tree).
#
# Usage:
#   review-stamp write --id ISSUE-1 --sha <SHA> --verdict PASS|FAILED \
#                      --independent yes|no [--round N] [--dir <path>]
#   review-stamp check --id ISSUE-1 [--dir <path>]
#
# `write` refuses unless <SHA> is the HEAD of --dir (default: cwd) and the tree
# is clean. `check` always exits 0 on a valid call; read REVIEW=.
#
# Output (KEY=VALUE):
#   write: WROTE=<ID> SHA= VERDICT= INDEPENDENT= ROUND=
#   check: REVIEW=PASS|STALE|MISSING|FAILED
#          SHA=<stamped sha> HEAD=<current sha> INDEPENDENT=yes|no ROUND=<n>
#          NOTE=<text>   0+ advisory lines (for example: dirty tree)
#   ERROR=<reason> (exit 2)
#
# REVIEW values: PASS = stamped PASS, same HEAD, clean tree. FAILED = stamped
# FAILED on the current HEAD. STALE = HEAD moved or the tree is dirty since the
# stamp. MISSING = no stamp for this issue.
set -uo pipefail
die() { echo "ERROR=$*"; exit 2; }

cmd=${1:-}; [ $# -gt 0 ] && shift
ID= SHA= VERDICT= INDEP= ROUND=0 DIR=.
while [ $# -gt 0 ]; do
  case "$1" in
    --id)          [ $# -ge 2 ] || die "need --id"; ID=$2; shift 2 ;;
    --sha)         [ $# -ge 2 ] || die "need --sha"; SHA=$2; shift 2 ;;
    --verdict)     [ $# -ge 2 ] || die "need --verdict"; VERDICT=$2; shift 2 ;;
    --independent) [ $# -ge 2 ] || die "need --independent"; INDEP=$2; shift 2 ;;
    --round)       [ $# -ge 2 ] || die "need --round"; ROUND=$2; shift 2 ;;
    --dir)         [ $# -ge 2 ] || die "need --dir"; DIR=$2; shift 2 ;;
    *) die "unknown arg: $1" ;;
  esac
done

case "$cmd" in write|check) ;; *) die "unknown-command: ${cmd:-<none>}" ;; esac
git -C "$DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "not-in-git-repo"
[ -n "$ID" ] || die "need --id"
[[ "$ID" =~ ^[A-Z][A-Z0-9_]*-[0-9]+$ ]] || die "bad-id: $ID"
[[ "$ROUND" =~ ^[0-9]+$ ]] || die "bad-round: $ROUND"

gitdir=$(cd "$DIR" && cd "$(git rev-parse --git-common-dir)" && pwd) || die "no-git-dir"
stampdir="$gitdir/youtrack-task/reviews"
stamp="$stampdir/$ID"
head=$(git -C "$DIR" rev-parse HEAD 2>/dev/null) || die "no-commits"
dirty=$(git -C "$DIR" status --porcelain 2>/dev/null)

if [ "$cmd" = write ]; then
  case "$VERDICT" in PASS|FAILED) ;; *) die "bad-verdict: ${VERDICT:-<none>}" ;; esac
  case "$INDEP" in yes|no) ;; *) die "bad-independent: ${INDEP:-<none>}" ;; esac
  [ "$SHA" = "$head" ] || die "sha-not-head: HEAD is $head"
  [ -z "$dirty" ] || die "dirty: commit or stash changes before stamping"
  mkdir -p "$stampdir" || die "cannot-create: $stampdir"
  tmp=$(mktemp "$stampdir/.tmp.XXXXXX") || die "cannot-create-temp"
  {
    echo "SHA=$SHA"
    echo "VERDICT=$VERDICT"
    echo "INDEPENDENT=$INDEP"
    echo "ROUND=$ROUND"
    echo "DATE=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  } > "$tmp" && mv "$tmp" "$stamp" || { rm -f "$tmp"; die "write-failed"; }
  echo "WROTE=$ID"
  echo "SHA=$SHA"
  echo "VERDICT=$VERDICT"
  echo "INDEPENDENT=$INDEP"
  echo "ROUND=$ROUND"
  exit 0
fi

# check
if [ ! -f "$stamp" ]; then
  echo "REVIEW=MISSING"
  echo "HEAD=$head"
  exit 0
fi
field() { sed -n "s/^$1=\\(.*\\)\$/\\1/p" "$stamp" | head -1; }
s_sha=$(field SHA); s_verdict=$(field VERDICT); s_indep=$(field INDEPENDENT); s_round=$(field ROUND)
if ! [[ "$s_sha" =~ ^[0-9a-f]{40,64}$ ]] || ! [[ "$s_verdict" =~ ^(PASS|FAILED)$ ]] \
   || ! [[ "$s_indep" =~ ^(yes|no)$ ]]; then
  echo "REVIEW=MISSING"
  echo "HEAD=$head"
  echo "NOTE=stamp for $ID is unreadable; treat as missing"
  exit 0
fi

if [ "$s_sha" != "$head" ]; then
  result=STALE
elif [ "$s_verdict" = FAILED ]; then
  result=FAILED
elif [ -n "$dirty" ]; then
  result=STALE
  note="working tree is dirty since the stamp"
else
  result=PASS
fi
echo "REVIEW=$result"
echo "SHA=$s_sha"
echo "HEAD=$head"
echo "INDEPENDENT=$s_indep"
echo "ROUND=${s_round:-0}"
[ -z "${note:-}" ] || echo "NOTE=$note"
exit 0
