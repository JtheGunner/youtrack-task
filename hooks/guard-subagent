#!/usr/bin/env bash
# PreToolUse hook (Bash, Edit, Write, MultiEdit) for the `all` sub-command's agents.
#
# Only acts when the call comes from a `ticket-worker` or `ticket-reviewer`
# subagent (hook input carries `agent_type`); every other call passes untouched.
#
#   File tools (Edit / Write / MultiEdit) of the ticket-worker may only write
#                   inside the worktree derived from the hook input's `cwd`
#                   (the linked worktree `cwd` is in; when `cwd` is the main
#                   checkout, any linked worktree of the repo) and never to a
#                   path with a `.git` component. Paths are collapsed (`..`) and
#                   symlinks resolved before the check. Without a git repo around
#                   `cwd` only the `.git` rule applies. Known limit: when `cwd` is
#                   the main checkout the worker may still write into the
#                   worktree of another issue. Write targets of Bash commands
#                   (redirections, cp, mv, tee, ln) are not path-checked.
#
#   ticket-worker   develops and commits locally. Denied: any `git push`,
#                   `gh pr merge`, `gh api`, network tools (curl, wget, ssh, …),
#                   hook bypass (`git commit --no-verify` / `-n`), forced branch
#                   deletion, `git config` writes (aliases), global git options,
#                   history rewriting (`commit --amend`, `reset --hard`, `clean`,
#                   `rebase`, `update-ref`, `filter-branch`, `worktree remove
#                   --force`), repointing the base refs the reviewer trusts
#                   (`symbolic-ref` writes, `remote set-head`, `branch -f/-m/-c`), `gh repo|release|secret|pr create`,
#                   shell wrappers / `-c` / `eval`, command substitution.
#   ticket-reviewer is read-only: an ALLOWLIST of inspection commands and test
#                   runners with per-command argument limits; no heredocs, no
#                   output redirection into files. Extra whole commands come from
#                   `reviewer_commands` (user config) and `.youtrack-task/reviewer-commands`
#                   on the base branch, matched exactly (see reviewer_extra_allows).
#
# Quoted text is data: separators and `>` inside quotes are masked before the
# command is split, heredoc bodies are dropped, and words inside quotes never
# trigger a deny rule (a commit message may mention "git push").
#
# This is a best-effort guard layered on the agents' own instructions, not a
# security boundary: shell syntax is too rich to police completely. Known limits
# the worker is NOT stopped from: interpreter one-liners (python3 -c, node -e,
# php -r) and package installs, which can run arbitrary code or reach the
# network. The real protection is server-side — branch protection on the
# default branch and a token without merge / force-push rights. Where a construct can hide the real
# command it is rejected outright instead of parsed.
#
# The rejection text goes to stderr (exit 2) and is shown to the model.
# Fails open: without jq (a warning goes to stderr), or on input it can't parse,
# the call goes through.
set -u

if ! command -v jq >/dev/null 2>&1; then
  echo "youtrack-task hook guard-subagent: jq is not installed, so the ticket-worker / ticket-reviewer guard is INACTIVE. Install jq to enable it." >&2
  exit 0
fi

input=$(cat)
agent=$(printf '%s' "$input" | jq -r '.agent_type // empty' 2>/dev/null) || exit 0
tool=$(printf '%s' "$input" | jq -r '.tool_name // empty' 2>/dev/null) || exit 0
cmd=$(printf '%s' "$input" | jq -r '.tool_input.command // empty' 2>/dev/null) || exit 0

case "$agent" in
  *ticket-worker) role=worker ;;
  *ticket-reviewer) role=reviewer ;;
  *) exit 0 ;;
esac

deny() {
  printf 'Call blocked for the %s agent: %s\n' "$role" "$1" >&2
  exit 2
}

# --- file tools: the worker writes only inside its worktree -------------------
# Collapse "." / ".." / empty components of an absolute path.
collapse_path() {
  printf '%s' "$1" | awk -F/ '{
    n = 0
    for (i = 1; i <= NF; i++) {
      if ($i == "" || $i == ".") continue
      if ($i == "..") { if (n > 0) n--; continue }
      s[++n] = $i
    }
    out = ""
    for (i = 1; i <= n; i++) out = out "/" s[i]
    print (out == "" ? "/" : out)
  }'
}

# Resolve symlinks of the deepest existing part of an absolute path (the file may
# not exist yet). A symlink to a file is followed too (bounded depth).
physical_path() {
  local p d rest="" base target depth=${2:-0}
  p=$(collapse_path "$1")
  [ "$depth" -le 8 ] || { printf '%s' "$p"; return; }
  d=$p
  while [ ! -e "$d" ] && [ ! -L "$d" ] && [ "$d" != / ]; do
    rest="/${d##*/}$rest"
    d=${d%/*}
    [ -n "$d" ] || d=/
  done
  if [ -d "$d" ]; then
    d=$(cd "$d" 2>/dev/null && pwd -P) || d=$p
    [ "$d" = / ] && d=""
    printf '%s%s' "$d" "$rest"
  elif [ -L "$d" ]; then
    target=$(readlink "$d")
    case "$target" in /*) ;; *) target="${d%/*}/$target" ;; esac
    physical_path "$target$rest" $((depth + 1))
  else
    base=${d##*/}
    d=$(cd "${d%/*}" 2>/dev/null && pwd -P) || d=${d%/*}
    [ "$d" = / ] && d=""
    printf '%s/%s%s' "$d" "$base" "$rest"
  fi
}

case "$tool" in
  Edit | Write | MultiEdit)
    [ "$role" = worker ] || exit 0
    file=$(printf '%s' "$input" | jq -r '.tool_input.file_path // empty' 2>/dev/null) || exit 0
    cwd=$(printf '%s' "$input" | jq -r '.cwd // empty' 2>/dev/null) || exit 0
    [ -n "$file" ] || exit 0
    [ -n "$cwd" ] || cwd=$PWD
    case "$file" in /*) ;; *) file="$cwd/$file" ;; esac

    lexical=$(collapse_path "$file")
    physical=$(physical_path "$file")
    for candidate in "$lexical" "$physical"; do
      # Case-insensitive: on macOS / Windows `.GIT` is the same directory as `.git`.
      candidate=$(printf '%s' "$candidate" | tr '[:upper:]' '[:lower:]')
      case "$candidate/" in
        */.git/*) deny "never write inside .git (hooks, config, refs): $file" ;;
      esac
    done

    top=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null) || exit 0
    top=$(physical_path "$top")
    gitdir=$(git -C "$cwd" rev-parse --absolute-git-dir 2>/dev/null) || exit 0
    common=$(git -C "$cwd" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || exit 0
    if [ "$(physical_path "$gitdir")" = "$(physical_path "$common")" ]; then
      # cwd is the main checkout: only the repo's linked worktrees are writable.
      roots=$(git -C "$top" worktree list --porcelain 2>/dev/null | sed -n 's/^worktree //p')
      main_root=$top
    else
      roots=$top
      main_root=
    fi
    while IFS= read -r root; do
      [ -n "$root" ] || continue
      root=$(physical_path "$root")
      [ "$root" != "$main_root" ] || continue
      case "$physical" in "$root"/*) exit 0 ;; esac
    done <<EOF_ROOTS
$roots
EOF_ROOTS
    deny "file tools may only write inside the worktree (derived from cwd $cwd); $file is outside."
    ;;
esac

[ -n "$cmd" ] || exit 0

# --- constructs that hide the real command: refuse, don't parse -------------
# shellcheck disable=SC2016 # intentional: match the literal characters $( ` <( >(
case "$cmd" in
  *'$('* | *'`'* | *'<('* | *'>('*) deny "no command substitution or process substitution." ;;
esac

# awk helpers (BSD/GNU compatible): drop heredoc bodies; mask or empty quotes.
awk_heredoc=$(cat <<'AWK'
# Quote state is tracked character by character across lines, exactly like the
# quote masker, so a "<<" inside a (possibly multi-line) quote is never taken
# for a heredoc operator.
BEGIN { q = ""; skip = 0 }
skip { t = $0; sub(/^[\t ]+/, "", t); if (t == word) skip = 0; next }
{
  print
  n = length($0)
  for (i = 1; i <= n; i++) {
    c = substr($0, i, 1)
    if (q == "") {
      if (c == "'" || c == "\"") { q = c; continue }
      if (c == "\\") { i++; continue }
      if (c == "<" && substr($0, i + 1, 1) == "<" && substr($0, i + 2, 1) != "<" && substr($0, i - 1, 1) != "<") {
        rest = substr($0, i + 2)
        if (match(rest, /^-?[ \t]*["']?[A-Za-z_][A-Za-z0-9_]*["']?/)) {
          w = substr(rest, RSTART, RLENGTH); after = substr(rest, RSTART + RLENGTH)
          sub(/^-?[ \t]*["']?/, "", w); sub(/["']$/, "", w)
          # The delimiter must be a whole word; anything glued to it (EOF"x", END-OF) is read
          # differently by bash, and so is a quote still open at the end of this line.
          if (after != "" && substr(after, 1, 1) !~ /[ \t;|&<>)]/) { print "@@BAD@@"; break }
          # Opening and closing quote of the delimiter must be the same character (or both absent).
          oq = substr(rest, RSTART, RLENGTH); sub(/^-?[ \t]*/, "", oq)
          fq = substr(oq, 1, 1); lq = substr(oq, length(oq), 1)
          if ((fq == "'" || fq == "\"") != (lq == "'" || lq == "\"") || (fq ~ /["']/ && fq != lq)) { print "@@BAD@@"; break }
          # Anything on the operator line we cannot model (quotes, expansions, comments): fail closed.
          if (after ~ /[$`#'"\\]/) { print "@@BAD@@"; break }
          word = w; skip = 1; break
        } else { print "@@BAD@@"; break }                          # a heredoc we cannot read: fail closed
      }
    } else {
      if (c == q) { q = ""; continue }
      if (q == "\"" && c == "\\") { i++; continue }
    }
  }
}
END { if (skip) print "@@BAD@@" }                               # unterminated heredoc
AWK
)
awk_quotes=$(cat <<'AWK'
BEGIN { RS = "\001"; ORS = "" }
{
  n = length($0); q = ""; out = ""; bad = 0
  for (i = 1; i <= n; i++) {
    c = substr($0, i, 1)
    if (q == "") {
      if (c == "$" && (substr($0, i + 1, 1) == "'" || substr($0, i + 1, 1) == "\"")) bad = 1   # ANSI-C / locale quoting
      if (c == "#" && (i == 1 || substr($0, i - 1, 1) ~ /[ \t\n;|&(]/)) bad = 1               # shell comment
      if (c == "'" || c == "\"") { q = c; out = out c; continue }
      if (c == "\\") { out = out c substr($0, i + 1, 1); i++; continue }
      out = out c
    } else {
      if (c == q) { q = ""; out = out c; continue }
      if (q == "\"" && c == "\\") { if (mode == "mask") out = out "__"; i++; continue }
      if (mode == "mask") { if (c ~ /[;&|<>(){}$\n]/) out = out "_"; else out = out c }
    }
  }
  if (q != "") bad = 1                                                                      # unterminated quote
  print out
  if (bad) print "@@BAD@@"
}
AWK
)

if [ "$role" = reviewer ]; then
  case "$cmd" in *'<<'*) deny "the reviewer is read-only (no heredocs)." ;; esac
  # A backslash before a newline joins two lines in the real shell but is validated as two
  # separate segments here, which would let an option hide in the second one.
  # shellcheck disable=SC1003 # intentional: match a literal backslash followed by a newline
  case "$cmd" in *'\'$'\n'* | *'\'$'\r'*) deny "the reviewer is read-only (no line continuations with a trailing backslash)." ;; esac
  body=$cmd
else
  body=$(printf '%s\n' "$cmd" | awk "$awk_heredoc")
fi

[ "${#body}" -le 20000 ] || deny "command is too long; split it into smaller steps."

case "$body" in *'@@BAD@@'*) deny "unterminated or quoted heredoc operator; write a plain heredoc or use the Write tool." ;; esac

masked=$(printf '%s\n' "$body" | awk -v mode=mask "$awk_quotes")   # structure: quotes kept, separators inside hidden
emptied=$(printf '%s\n' "$body" | awk -v mode=empty "$awk_quotes") # content: quoted text removed

# `git -C <dir> ...` -> `git ...`; drop harmless redirections.
clean() {
  printf '%s' "$1" | sed -E 's/git +-C +[^ ;&|]+/git/g; s#&> *(/dev/null)##g; s#[0-9]*>>? *(/dev/null)([ ;&|]|$)#\2#g; s#[0-9]*>&[0-9-]+([ ;\&|]|$)#\1#g'
}
masked=$(clean "$masked")
emptied=$(clean "$emptied")
case "$masked" in *'@@BAD@@'*) deny "no shell comments, \$'...' quoting or unterminated quotes; run plain commands." ;; esac

# shellcheck disable=SC2020 # intentional: each tr maps single characters to newline
segments() { printf '%s\n' "$1" | tr ';&|' '\n\n\n' | tr -s ' \t' ' ' | sed -E 's/^ +//; s/ +$//'; }

[ "$(segments "$masked" | wc -l)" -le 80 ] || deny "too many chained commands (max 80); split the work into smaller steps."

bad_env_re='^(PATH|LD_[A-Z_]*|DYLD_[A-Z_]*|GIT_[A-Z_]*|BASH_ENV|ENV|SHELL|IFS|PROMPT_COMMAND|HOME|GRADLE_[A-Za-z0-9_]*|ORG_GRADLE_[A-Za-z0-9_]*|JAVA_[A-Za-z0-9_]*|_JAVA_OPTIONS|JDK_[A-Za-z0-9_]*|ANDROID_[A-Za-z0-9_]*|KOTLIN_[A-Za-z0-9_]*|TMPDIR)='

# Remove leading VAR=value assignments so the real command is visible; refuse
# assignments that change how commands are found or run.
strip_assignments() {
  local s=$1
  while printf '%s' "$s" | grep -Eq '^[A-Za-z_][A-Za-z0-9_]*=[^ ]*( |$)'; do
    if printf '%s' "$s" | grep -Eq "$bad_env_re"; then
      printf 'Command blocked for the %s agent: do not set PATH, GIT_*, LD_*, HOME or similar variables.\n' "$role" >&2
      return 3
    fi
    s=$(printf '%s' "$s" | sed -E 's/^[A-Za-z_][A-Za-z0-9_]*=[^ ]* *//')
  done
  printf '%s' "$s"
}

# Gradle: only read-only check tasks, with an optional project path
# (:feature:play:testDebugUnitTest) and a fixed set of harmless options.
#   tasks:   exactly test / check / lint / detekt / ktlintCheck / spotlessCheck, lint(Debug|Release|Vital|
#            VitalRelease), or test<Variant>UnitTest (testDebugUnitTest). No prefix patterns:
#            Gradle expands camelCase abbreviations, so lintF would run lintFix.
#            Names that write sources or baselines (Fix, Baseline, Format, Apply, Generate, Update, …)
#            are denied even when they start with an allowed word.
#   Values (--tests, -x) contain no glob characters: this validator splits without globbing,
#   the real shell would expand them.
#   options: no -D / -P (they can set org.gradle.* daemon / JVM settings or steer the build), no
#            -I / -b / -c / -g / -p (other scripts or directories).
# Build, publish and clean tasks are not on the list.
gradle_allows() {
  local tok task expect_value=0 seen_task=0
  case "$1" in 'gradle '* | 'gradlew '* | './gradlew '*) ;; *) return 1 ;; esac
  set -f
  for tok in ${1#* }; do
    if [ "$expect_value" = 1 ]; then
      expect_value=0
      if ! printf '%s' "$tok" | grep -Eq '^[A-Za-z0-9_.:#,-]+$' || printf '%s' "$tok" | grep -Eq '^-'; then
        set +f; return 1
      fi
      continue
    fi
    case "$tok" in
      --tests | -x | --exclude-task) expect_value=1 ;;
      --tests=*) printf '%s' "$tok" | grep -Eq '^--tests=[A-Za-z0-9_.:#,][A-Za-z0-9_.:#,-]*$' || { set +f; return 1; } ;;
      --no-daemon | --daemon | --offline | --continue | --parallel | --no-parallel | --quiet | -q | --info | -i | --warn | -w | \
      --stacktrace | -s | --full-stacktrace | -S | --rerun-tasks | --build-cache | --no-build-cache | --configuration-cache | \
      --no-configuration-cache | --dry-run | -m | --console=plain | --console=auto | --console=rich | --console=verbose) ;;
      -*) set +f; return 1 ;;
      *)
        task=${tok##*:}
        printf '%s' "$tok" | grep -Eq '^([A-Za-z0-9_-]*:)*[A-Za-z0-9_]+$' || { set +f; return 1; }
        # Exact names only: Gradle resolves camelCase abbreviations (lintF -> lintFix), so a prefix
        # pattern would let write tasks through. Variant suffixes must be spelled out in full.
        printf '%s' "$task" | grep -Eq '^(test|check|lint|detekt|ktlintCheck|spotlessCheck|lint(Debug|Release|Vital|VitalRelease)|test[A-Z][A-Za-z0-9]*UnitTest)$' || { set +f; return 1; }
        ! printf '%s' "$task" | grep -Eiq 'Fix|Baseline|Format|Apply|Generate|Update|Install|Publish|Upload|Deploy|Write|Create|Migrate|Clean' || { set +f; return 1; }
        seen_task=1 ;;
    esac
  done
  set +f
  [ "$expect_value" = 0 ] && [ "$seen_task" = 1 ]
}

# ---- reviewer: project-specific verification commands (exact match) ------------
# Two sources extend the built-in allowlist, each entry a WHOLE command that must equal
# the checked command word for word (no regex, no prefix):
#   1. `reviewer_commands` in the user config, resolved by the skill's read-config.
#   2. `.youtrack-task/reviewer-commands` as committed on the BASE branch: one command
#      per line, full-line `#` comments. It is read with `git show <base-commit>:<path>`,
#      never from the working tree, so the branch under review cannot allow commands for
#      itself; a change to the list has to be merged into the base branch first. The base
#      is resolved from FULL ref names only (see base_ref), so a tag cannot shadow it.
# Every deny rule of reviewer_allows (path traversal, --web, ...) still runs before this,
# and redirections, heredocs, `;`, `&&` and `|` are rejected before a command is compared.
REVIEWER_COMMANDS_FILE='.youtrack-task/reviewer-commands'
reviewer_extra_loaded=0
reviewer_extra_list=""

# Echoes the commit id of the base branch of the repo around $1, or nothing. Only FULL ref
# names are resolved: a short name such as `main` or `origin/main` is matched against tags
# first, so a tag created in the checkout would shadow the real base branch. Remote-tracking
# refs win over local branches; `git show` then gets the commit id, not a name.
base_ref() {
  local dir=$1 head ref oid
  head=$(git -C "$dir" symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null)
  for ref in "$head" refs/remotes/origin/main refs/remotes/origin/master refs/heads/main refs/heads/master; do
    case "$ref" in refs/remotes/* | refs/heads/*) ;; *) continue ;; esac
    oid=$(git -C "$dir" rev-parse --verify --quiet "$ref^{commit}" 2>/dev/null)
    if [ -n "$oid" ]; then printf '%s' "$oid"; return 0; fi
  done
  return 0
}

# One entry per line, normalised like a checked command: no quotes or backslashes, single spaces.
normalize_entries() {
  tr -d '\r' | sed -E "s/[\"'\\\\]//g; s/[[:space:]]+/ /g; s/^ //; s/ \$//" | grep -v '^$'
}

load_reviewer_extra() {
  local cwd_dir base config_file
  config_file="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/skills/youtrack-task/scripts/read-config"
  if [ -x "$config_file" ]; then
    "$config_file" reviewer_commands 2>/dev/null | tr ';' '\n' | normalize_entries
  fi
  cwd_dir=$(printf '%s' "$input" | jq -r '.cwd // empty' 2>/dev/null)
  [ -n "$cwd_dir" ] || cwd_dir=$PWD
  base=$(base_ref "$cwd_dir")
  [ -n "$base" ] || return 0
  git -C "$cwd_dir" show "$base:$REVIEWER_COMMANDS_FILE" 2>/dev/null | grep -v '^[[:space:]]*#' | normalize_entries
}

reviewer_extra_allows() {
  local checked=$1 entry
  if [ "$reviewer_extra_loaded" = 0 ]; then
    reviewer_extra_loaded=1
    reviewer_extra_list=$(load_reviewer_extra)
  fi
  [ -n "$reviewer_extra_list" ] || return 1
  while IFS= read -r entry; do
    [ "$entry" = "$checked" ] && return 0
  done <<< "$reviewer_extra_list"
  return 1
}

reviewer_allows() {
  # Quotes and backslashes are removed first so they cannot hide an option.
  local s
  s=${1//\'/}; s=${s//\"/}; s=${s//\\/}
  # Per-tool argument limits for commands that can write or execute. Options
  # may be attached (-oFILE), clustered (-no) or abbreviated (--outp).
  printf '%s' "$s" | grep -Eq '^git (diff|log|show|diff-tree|shortlog|blame|cat-file)( .*)? --ou(t|tp|tpu|tput)?( |=|$)' && return 1
  printf '%s' "$s" | grep -Eq '^git grep( .*)? (-[a-zA-Z]*O|--op[a-z-]*)' && return 1
  printf '%s' "$s" | grep -Eq '^(rg|grep)( .*)? --pre' && return 1
  printf '%s' "$s" | grep -Eq '^git( .*)? --(ext-diff|textconv)' && return 1
  printf '%s' "$s" | grep -Eq '^find( .*)? -(f(ls|print[0-9a-z]*)|exec(dir)?|ok(dir)?|delete)( |$)' && return 1
  printf '%s' "$s" | grep -Eq '^tail( .*)? (-[a-zA-Z]*f|--follow)' && return 1
  printf '%s' "$s" | grep -Eq '^gh( .*)? --web' && return 1
  printf '%s' "$s" | grep -Eq '(^|[ /=])\.\.(/|$| )' && return 1   # no path traversal out of the repo

  case "$s" in 'gradle '* | 'gradlew '* | './gradlew '*) gradle_allows "$s"; return $? ;; esac
  printf '%s' "$s" | grep -Eq '^git (status|diff|rev-parse|rev-list|ls-files|ls-tree|blame|cat-file|merge-base|name-rev|grep|diff-tree|shortlog)( |$)' && return 0
  printf '%s' "$s" | grep -Eq '^git (remote -v|stash list|tag( -l| --list)?|branch( (--list|-a|-r|--show-current|-vv))*)$' && return 0
  printf '%s' "$s" | grep -Eq '^gh (run (list|view)|pr (diff|checks|status))( |$)' && return 0
  printf '%s' "$s" | grep -Eq '^(cd|ls|cat|head|tail|wc|grep|rg|diff|jq|echo|pwd|stat|file|uniq|cut|tr|find|date|which|true|test|\[|\[\[)( |$)' && return 0
  printf '%s' "$s" | grep -Eq '^sed -n [0-9$,]+p( [^ -][^ ]*)*$' && return 0
  printf '%s' "$s" | grep -Eq '^(npm|pnpm|yarn|bun) (test|run (test|lint|typecheck|check)[a-z:-]*)( |$)' && return 0
  printf '%s' "$s" | grep -Eq '^npx (--no-install )?(jest|vitest|tsc|eslint|playwright test)( |$)' && return 0
  # Build and lint without write or steering options: no -o / -toolexec / -ldflags / --fix / -Xswiftc /
  # --package-path, no single-package `go build` (it would drop a binary into the checkout).
  printf '%s' "$s" | grep -Eq '^swift (test|build)( (--filter|--skip|--configuration|-c) [A-Za-z0-9_./:#-]+| --parallel| --no-parallel| --verbose| -v| --enable-code-coverage)*$' && return 0
  printf '%s' "$s" | grep -Eq '^go build \./\.\.\.$' && return 0
  printf '%s' "$s" | grep -Eq '^golangci-lint run( -v| --timeout[= ][0-9]+[smh]| \./[A-Za-z0-9_./-]*)*$' && return 0
  printf '%s' "$s" | grep -Eq '^((bash|sh) )?(\./)?scripts/[A-Za-z0-9._-]*test[A-Za-z0-9._-]*( |$)' && return 0
  printf '%s' "$s" | grep -Eq '^((php )?(\./)?vendor/bin/(phpunit|pest|phpstan|pint|psalm|rector|phpcs)|pytest|python3? -m pytest|ruff check|eslint|php -l|phpunit|pest|phpstan|php artisan test|composer (test|run(-script)? (test|lint|analyse|check)[a-z:-]*)|go (test|vet)|cargo (test|clippy|check)|make( -[a-zA-Z]+)* (test|check|lint)|ctest|mvn( -[a-zA-Z]+)* test|dotnet test|bats|shellcheck|bash -n|(bash|sh) (\./)?tests?/[A-Za-z0-9._/-]+)( |$)' && return 0
  reviewer_extra_allows "$s" && return 0
  return 1
}

# ---- structure pass (quotes kept, separators inside quotes hidden) ---------
while IFS= read -r segment; do
  [ -n "$segment" ] || continue

  # Shell keywords, grouping and variable expansion in the command word.
  printf '%s' "$segment" | grep -Eq '^(if|then|else|elif|fi|do|done|while|until|case|esac|for|select|coproc|function|time)([ ()<>]|$)|^[^ ]*[(){}$]|^!' \
    && deny "no shell keywords, grouping or variable expansion in the command word; run plain commands."
  # Unquoted grouping anywhere (function definitions, subshells, brace groups).
  printf '%s' "$segment" | grep -Eq '[()]|(^| )[{}]( |$)' \
    && deny "no unquoted parentheses or brace groups (function definitions, subshells); run plain commands."
  # Quoted or escaped command / subcommand words may hide the real command.
  printf '%s' "$segment" | grep -Eq "^[^ ]*['\"\\\\]|^(git|gh) +[^ ]*['\"\\\\]|^gh +[^ ]+ +[^ ]*['\"\\\\]" \
    && deny "no quotes or backslashes inside the command or subcommand name."

  segment=$(strip_assignments "$segment") || exit 2
  [ -n "$segment" ] || continue

  if [ "$role" = reviewer ]; then
    reviewer_allows "$segment" \
      || deny "[blocked-by-guard] the reviewer is read-only; '$segment' is not on its allowlist (inspect with git diff / grep / cat, run the project's tests). Report it as blocked-by-guard, not as a code finding."
    continue
  fi

  printf '%s' "$segment" | grep -Eq '^((bash|sh|zsh|dash|ksh) -[a-zA-Z]*c|eval|exec|env|command|builtin|xargs|nohup|sudo|time|nice|timeout|stdbuf|ionice|setsid)( |$)' \
    && deny "no shell -c, eval, wrapper or xargs invocations; run the command directly."
  printf '%s' "$segment" | grep -Eq '^[^ ]*/(git|gh)( |$)' && deny "call git and gh by name, not by path."
done < <(segments "$masked")

if [ "$role" = reviewer ]; then
  case "$masked" in *'>'*) deny "the reviewer is read-only (no output redirection into files)." ;; esac
  exit 0
fi

# ---- content pass (worker; quoted text removed so messages are not scanned) --
while IFS= read -r segment; do
  [ -n "$segment" ] || continue
  segment=$(strip_assignments "$segment") || exit 2
  printf '%s' "$segment" | grep -Eq '^(curl|wget|nc|ncat|ssh|scp|sftp|telnet|ftp)( |$)' \
    && deny "no network tools; the worker works locally and never talks to remote services."
  printf '%s' "$segment" | grep -Eq '^(source|\.|alias|unalias|shopt|trap|hash|enable|declare -[a-zA-Z]*f|typeset -[a-zA-Z]*f|export -[a-zA-Z]*f)( |$)' \
    && deny "no sourcing scripts, aliases, traps or shell function/option tricks."
  printf '%s' "$segment" | grep -Eq '^gh api( |$)' && deny "gh api is not allowed for this agent."
  printf '%s' "$segment" | grep -Eq '^gh pr merge( |$)' && deny "merging is done by the main session only."
  printf '%s' "$segment" | grep -Eq '^gh (repo|release|secret)( |$)' \
    && deny "no gh repo / release / secret commands; those change things outside the branch."
  printf '%s' "$segment" | grep -Eq '^gh pr create( |$)' \
    && deny "pull requests are opened by the main session only."
  if printf '%s' "$segment" | grep -Eq '^git( |$)'; then
    printf '%s' "$segment" | grep -Eq '^git -' && deny "no git options before the subcommand (other than -C <dir>)."
    printf '%s' "$segment" | grep -Eq '^git (send-pack|http-push|remote (add|set-url))( |$)|^git (fetch|pull|clone|ls-remote|archive)( .*)? (--upload-pack|--receive-pack|--exec)' \
      && deny "no remote-writing or remote-reconfiguring git commands."
    printf '%s' "$segment" | grep -Eq '^git push( |$)' \
      && deny "workers never push; commit locally and report. The main session pushes after review."
    printf '%s' "$segment" | grep -Eq '^git config( |$)' \
      && ! printf '%s' "$segment" | grep -Eq '^git config (--get|--get-all|--list|-l)( |$)' \
      && deny "git config is read-only for this agent (no aliases or hook paths)."
    printf '%s' "$segment" | grep -Eq '^git (commit|merge|am|rebase|cherry-pick|revert)( .*)? (-[a-zA-Z]*n[a-zA-Z]*|--no-ver[a-z-]*)( |$)' \
      && deny "never bypass git hooks (no --no-verify / -n)."
    printf '%s' "$segment" | grep -Eq '^git (commit( .*)? --am(e(n(d)?)?)?|reset( .*)? --h[a-z]*|clean|rebase|update-ref|filter-branch)( |=|$)|^git worktree remove( .*)? (-[a-zA-Z]*f[a-zA-Z]*|--f[a-z]*)( |$)' \
      && deny "no history rewriting or destructive commands (amend, reset --hard, clean, rebase, update-ref, filter-branch, worktree remove --force)."
    printf '%s' "$segment" | grep -Eq '^git branch( .*)? -[a-zA-Z]*D' && deny "never force-delete a branch."
    printf '%s' "$segment" | grep -Eq '^git branch( .*)? (-[a-zA-Z]*d|--delete)( .*)? (-[a-zA-Z]*f|--force)|^git branch( .*)? (-[a-zA-Z]*f|--force)( .*)? (-[a-zA-Z]*d|--delete)' \
      && deny "never force-delete a branch."
    # The reviewer reads .youtrack-task/reviewer-commands from the base branch (full ref names), so the
    # worker must not be able to repoint that base: origin/HEAD, a moved, renamed or copied branch.
    printf '%s' "$segment" | grep -Eq '^git (symbolic-ref( .*)? (-d|--delete)|symbolic-ref [^ -][^ ]* [^ ]|remote set-head|branch( .*)? (-[a-zA-Z]*[fmMcC]|--force|--move|--copy)( |$))' \
      && deny "no repointing of base refs (symbolic-ref writes, remote set-head, branch --force / --move / --copy)."
  fi
done < <(segments "$emptied")

exit 0
